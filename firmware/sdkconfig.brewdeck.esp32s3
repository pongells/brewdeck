# Brewdeck's ESP-IDF settings for the ESP32-S3 (Sunton board, N16R8), on top of the stock Arduino libraries' settings
# for the chip (framework-arduinoespressif32-libs/esp32s3/sdkconfig, read as they are: CMakeLists.txt).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_app3M_fat9M_16MB.csv"
# The stock settings are for quad PSRAM; this module has octal PSRAM (the libraries' qio_opi variant differs in these)
CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
# The settings Espressif recommends for an RGB panel + Wi-Fi (ESP-FAQ, LCD section); without them the picture jumps
# whenever Wi-Fi is busy.
# Run code + read-only data from PSRAM: Wi-Fi / flash activity no longer stalls the PSRAM the panel reads from
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# With code + read-only data in PSRAM, code that runs during a flash operation need not be in IRAM (ESP-IDF's help
# for SPIRAM_RODATA): the heap and ring buffer functions go there too, ~11 KB more internal RAM (it holds LVGL's hot
# loops, lv_conf.h, and Wi-Fi / lwIP buffers)
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# 64-byte data cache line is required with bounce buffers
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# CONFIG_ESP32S3_DATA_CACHE_LINE_32B is not set
# Keep Wi-Fi / lwIP buffers in internal RAM (less PSRAM traffic)
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
# Panel ISR keeps running during flash operations (safe now that PSRAM stays reachable)
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set
CONFIG_FREERTOS_HZ=1000
# Task stacks trimmed to what they use (measured, debug GET /tasks), for internal RAM: esp_timer used < 0.5 of 8 KB,
# mdns ~1.7 of 4 KB
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_MDNS_TASK_STACK_SIZE=3072
# Start from our app_main (src/core/main.cpp), not Arduino's setup() / loop()
# CONFIG_AUTOSTART_ARDUINO is not set
