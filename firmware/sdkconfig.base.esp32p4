# Base settings for the esp32p4, then Brewdeck's own changes in sdkconfig.brewdeck.esp32p4 (CMakeLists.txt reads
# both, this one first). Started from the settings the Arduino core's libraries were built with (pioarduino 55.03.312-1,
# ESP-IDF 5.5.5: kconfgen savedefconfig of framework-arduinoespressif32-libs/esp32p4/sdkconfig); reviewed in issue #11:
# what is left is kept for the reason next to it, the rest is ESP-IDF's default. Settings for features the firmware
# does not use (Bluetooth, Ethernet, TLS, HTTP server / client, USB host, FAT, ULP, IPv6 extras, routing) are not set.

# ---- boot, flash, partitions
# an update runs on trial until the core keeps it (core/ota.cpp)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# quiet, quick boot
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# partitions_app3M_fat9M_16MB.csv: two 3 MB app slots, a core dump area
CONFIG_PARTITION_TABLE_CUSTOM=y
# a crash leaves a core dump in its partition
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# flash writes / erases in small steps that let other tasks run (settings, updates; see issue #9 before changing)
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=10
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=2
CONFIG_SPI_FLASH_WRITE_CHUNK_SIZE=4096

# ---- memory
CONFIG_SPIRAM=y
# (sdkconfig.brewdeck.<chip> sets the PSRAM start-up)
CONFIG_SPIRAM_BOOT_HW_INIT=n
# blocks above 4 KB go to PSRAM: internal RAM is kept for Wi-Fi / lwIP
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# no internal RAM held back (the firmware allocates what it needs)
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0
# catches heap overruns at free
CONFIG_HEAP_POISONING_LIGHT=y
# no SPI devices: the SPI master interrupt and the bus lock (also the flash driver's) stay out of internal RAM
CONFIG_SPI_MASTER_ISR_IN_IRAM=n

# ---- tasks, watchdogs, checks
# 1 ms ticks (wait_ms, LVGL's timing)
CONFIG_FREERTOS_HZ=1000
# measured: ~0.7 KB used (GET /tasks)
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1024
# older FreeRTOS names in components
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
# task list for the debug server (GET /tasks)
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
# its handlers only set flags (core/wifi.cpp)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
# a hung task restarts the screen instead of freezing it
CONFIG_ESP_TASK_WDT_PANIC=y
# CPU 1 runs the UI task, which may hold it longer while drawing
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# stack smashing caught
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# ---- network
# the network stack on CPU 0, away from the UI on CPU 1
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
# REST, WebSocket, debug server, log sender, with room
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
# core/wifi.cpp sets two
CONFIG_LWIP_SNTP_MAX_SERVERS=3
# clock synced every 3 h
CONFIG_LWIP_SNTP_UPDATE_DELAY=10800000
# getaddrinfo also resolves "name.local" through mDNS
CONFIG_LWIP_HOOK_NETCONN_EXT_RESOLVE_DEFAULT=y
# selective acks: a lost packet on a weak link is resent alone
CONFIG_LWIP_TCP_SACK_OUT=y
# ESP-IDF's own warnings in the serial log too (the firmware's lines are its own, core/tlog.cpp)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# ---- ESP32-P4
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BT_ENABLED=n
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=n
CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_HOSTED_USE_MEMPOOL=n
# Wi-Fi block-ack windows through the ESP32-C6
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_RX_BA_WIN=16
# large TCP windows: updates and screenshots go faster, and the P4 has internal RAM to spare
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
