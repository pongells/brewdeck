# Brewdeck's ESP-IDF settings for the ESP32-P4, on top of the stock Arduino libraries' settings for the chip
# (framework-arduinoespressif32-libs/esp32p4/sdkconfig, read as they are: CMakeLists.txt).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_app3M_fat9M_16MB.csv"
# Run code + read-only data from PSRAM (XIP): writing flash (an update) no longer pauses the DSI panel's PSRAM reads,
# which made it flash light blue. XIP needs PSRAM set up at boot (the stock libraries leave it to psramInit).
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# ESP-Hosted receives from the C6 into two staging buffers by default: one is enough here and saves ~30 KB of internal
# RAM (2.x: SDIO_RX_DOUBLE_BUFFERING=n)
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STAGING_SLOTS=1
# Start from our app_main (src/core/main.cpp), not Arduino's setup() / loop()
# CONFIG_AUTOSTART_ARDUINO is not set
# The board's flash is a BOYA chip: name it (same generic functions either way; without it ESP-IDF warns at every boot
# "Detected boya flash chip but using generic driver")
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
# LVGL's component: only the library (its settings come from include/lv_conf.h, see CMakeLists.txt)
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
# ESP-Hosted's board preset: none, as in the Arduino core's ESP-IDF (plain ESP-IDF picks the Function EV board: the same
# SDIO pins, only narrower allowed ranges)
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
